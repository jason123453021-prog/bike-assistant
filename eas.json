{
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "distribution": "internal",
        "resourceClass": "default",
        "env": {
          "EXPO_DEBUG": "0",
          "SKIP_BUNDLER_CACHE_INVALIDATION": "1"
        }
      }
    },
    "preview2": {
      "android": {
        "buildType": "apk"
      }
    },
    "preview3": {
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "aab"
      }
    },
    "dev-client": {
      "android": {
        "buildType": "apk",
        "distribution": "internal",
        "developmentClient": true,
        "env": {
          "EXPO_DEBUG": "1"
        }
      }
    }
  },
  "cli": {
    "version": ">= 5.0.0"
  },
  "cache": {
    "key": "bike-assistant-cache",
    "disabled": false
  },
  "buildTimeout": 3600,
  "submit": {
    "production": {
      "android": {
        "serviceAccount": "~/.eas/google-services.json",
        "track": "internal"
      }
    }
  }
}
