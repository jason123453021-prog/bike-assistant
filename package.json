{
  "name": "bike-assistant",
  "version": "1.0.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm dev:preview",
    "dev:preview": "cross-env NODE_OPTIONS=--max-old-space-size=1536 EXPO_NO_METRO_WORKSPACE_ROOT=1 npx expo start --web --max-workers 1 --port ${EXPO_PORT:-8081}",
    "expo:go": "sh -c './scripts/prewarm-expo-go-bundle.sh & exec env -u EXPO_PACKAGER_PROXY_URL -u REACT_NATIVE_PACKAGER_HOSTNAME -u EXPO_APP_QR_URL cross-env NODE_OPTIONS=--max-old-space-size=1536 EXPO_NO_METRO_WORKSPACE_ROOT=1 npx expo start --tunnel --max-workers 1 --port ${EXPO_PORT:-8081}'",
    "build": "cross-env NODE_ENV=production expo export --platform web --output-dir dist && cp scripts/static-server.cjs dist/index.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:jest": "jest --config jest.config.cjs --runInBand",
    "test:automated": "pnpm test:jest && pnpm test",
    "test:e2e:maestro": "maestro test --format junit --output build/maestro-report.xml --test-output-dir build/maestro-results e2e/maestro",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@garmin/fitsdk": "^21.213.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "base64-js": "^1.5.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-battery": "^57.0.2",
    "expo-brightness": "~57.0.1",
    "expo-build-properties": "^57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "^57.0.14",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "i18next": "^26.4.0",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "ts-jest": "29.4.12",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0"
}
